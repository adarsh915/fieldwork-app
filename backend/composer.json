{
  "name": "ampl-fieldwork/backend",
  "description": "Laravel API backend for AMPL Fieldwork",
  "type": "project",
  "require": {
    "php": "^8.2",
    "barryvdh/laravel-dompdf": "^3.1",
    "blade-ui-kit/blade-heroicons": "^2.7",
    "blade-ui-kit/blade-icons": "^1.10",
    "laravel/framework": "^12.0",
    "laravel/sanctum": "^4.0",
    "mallardduck/blade-lucide-icons": "^1.26",
    "spatie/laravel-permission": "^6.25",
    "yajra/laravel-datatables-oracle": "^12.7"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "mockery/mockery": "^1.6",
    "pestphp/pest": "^3.8",
    "pestphp/pest-plugin-laravel": "^3.2"
  }
}
