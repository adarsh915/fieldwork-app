{
  "expo": {
    "name": "AMPL Fieldwork",
    "slug": "ampl-fieldwork-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#7367F0"
    },
    "extra": {
      "eas": {
        "projectId": "3e4f7a64-cc21-45fc-a0c5-a9075728c836"
      }
    },
    "android": {
      "package": "com.adarsh55.amplfieldworkmobile",
      "largeHeap": true,
      "googleServicesFile": "./google-services.json",
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#7367F0"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow AMPL Fieldwork to use your location for tracking field visits.",
          "locationAlwaysPermission": "Allow AMPL Fieldwork to use your location even when the app is in the background.",
          "locationWhenInUsePermission": "Allow AMPL Fieldwork to use your location while using the app.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-image-picker",
      "expo-image"
    ]
  }
}
